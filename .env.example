# Optional local OpenAI-compatible LLM (Ollama / LM Studio / vLLM)
# Native Windows Ollama example:
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=glm-5.3:cloud
LOCAL_LLM_API_KEY=ollama
LOCAL_LLM_TIMEOUT=300

# When dollar_watch itself runs in Docker and Ollama runs on the Windows host,
# use host.docker.internal instead of localhost:
# LOCAL_LLM_BASE_URL=http://host.docker.internal:11434/v1

# Persistent runtime data. Native installs normally need no override: the default
# is <Dollar Watch install root>/data and is preserved across release ZIPs.
# DOLLAR_WATCH_DATA_DIR=C:\Users\you\Documents\dollar_watch\data

# Optional explicit file overrides. Relative paths are anchored to the install root.
# DOLLAR_DASHBOARD_DB=data/dashboard.sqlite
# DOLLAR_POLICY_CACHE=data/official_policy_cache.json

# Docker uses the mounted /app/data runtime directory.
# DOLLAR_DASHBOARD_DB=/app/data/dashboard.sqlite
# DOLLAR_POLICY_CACHE=/app/data/official_policy_cache.json
