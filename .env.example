# Optional local OpenAI-compatible LLM (Ollama / LM Studio / vLLM)
# Native Windows Ollama example:
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=glm-5.3:cloud
LOCAL_LLM_API_KEY=ollama
LOCAL_LLM_TIMEOUT=300

# When dollar_watch itself runs in Docker and Ollama runs on the Windows host,
# use host.docker.internal instead of localhost:
# LOCAL_LLM_BASE_URL=http://host.docker.internal:11434/v1

# App data path (inside container if using Docker)
DOLLAR_DASHBOARD_DB=/app/data/dashboard.sqlite
